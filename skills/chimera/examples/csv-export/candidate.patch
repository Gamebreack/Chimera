diff --git a/test_export.py b/test_export.py
index 5b9e7e0..ea8049f 100644
--- a/test_export.py
+++ b/test_export.py
@@ -6,3 +6,26 @@ from export import csv_chunks
 class ExportTests(unittest.TestCase):
     def test_simple_rows(self):
         self.assertEqual("a,1\r\nb,2\r\n", "".join(csv_chunks([["a", 1], ["b", 2]])))
+
+    def test_empty_input(self):
+        self.assertEqual([], list(csv_chunks([])))
+
+    def test_special_characters(self):
+        self.assertEqual(
+            ['"a,b","say ""hi""","line\nbreak"\r\n'],
+            list(csv_chunks([["a,b", 'say "hi"', "line\nbreak"]])),
+        )
+
+    def test_reads_one_row_per_chunk(self):
+        consumed = []
+
+        def rows():
+            for value in ["first", "second", "third"]:
+                consumed.append(value)
+                yield [value]
+
+        chunks = csv_chunks(rows())
+        self.assertEqual("first\r\n", next(chunks))
+        self.assertEqual(["first"], consumed)
+        self.assertEqual("second\r\n", next(chunks))
+        self.assertEqual(["first", "second"], consumed)
